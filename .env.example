# Database Connection (Prisma)
# ------------------------------------------------------------------------------
# 1. Local Development (SQLite - Zero Setup):
DATABASE_URL="file:./dev.db"

# 2. Production / Cloud (PostgreSQL on Neon, Supabase, Railway, AWS RDS):
# (Note: In prisma/schema.prisma, change provider to "postgresql")
# DATABASE_URL="postgresql://user:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/payloop_pro?sslmode=require"

# 3. Docker Compose (Local PostgreSQL Container):
# DATABASE_URL="postgresql://payloop_user:payloop_password@postgres:5432/payloop_db?schema=public"


# Authentication & Session Security
# ------------------------------------------------------------------------------
# Generate random keys with: openssl rand -base64 32
JWT_SECRET="payloop_ultra_secure_jwt_secret_key_2026_fintech_production"
NEXTAUTH_SECRET="payloop_ultra_secure_nextauth_secret_key_2026_production"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# Stripe Payments Integration (Optional for Real Card Top-ups)
# ------------------------------------------------------------------------------
# Get your API keys at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_51..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."


# Email Delivery (Optional for Transactional Emails)
